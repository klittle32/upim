{
  "name": "@kylelittle/upim",
  "version": "0.3.0",
  "description": "Command-line client for the UnoPim 3.1 REST API, with OAuth, an agent-readable field contract, and an installable skill.",
  "author": "Kyle Little",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klittle32/upim.git"
  },
  "homepage": "https://github.com/klittle32/upim#readme",
  "bugs": {
    "url": "https://github.com/klittle32/upim/issues"
  },
  "type": "module",
  "bin": {
    "upim": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "upim": "node src/main.ts",
    "check": "tsc --noEmit --pretty false",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "effect": "4.1.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
