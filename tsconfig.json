{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/platform-node-shared",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/Terminal",
          "effect/cli",
          "effect/crypto",
          "effect/encoding",
          "effect/http",
          "effect/process"
        ],
        "diagnosticSeverity": {
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "nodeBuiltinImport": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "tryCatchInEffectGen": "error"
        },
        "overrides": [
          {
            "include": ["test/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "globalConsole": "off",
                "globalConsoleInEffect": "off",
                "globalDate": "off",
                "globalDateInEffect": "off",
                "globalFetch": "off",
                "globalFetchInEffect": "off",
                "globalRandom": "off",
                "globalRandomInEffect": "off",
                "globalTimers": "off",
                "globalTimersInEffect": "off",
                "nodeBuiltinImport": "off",
                "processEnv": "off",
                "processEnvInEffect": "off",
                "tryCatchInEffectGen": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["src", "test"]
}
